# Copie para backend/.env e configure valores próprios.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=aluguel_db
DB_USER=aluguel_user
DB_PASSWORD=substitua-pela-senha-do-postgres
NODE_PORT=8002
# Gere um valor aleatório de pelo menos 32 caracteres; NUNCA use senha pública.
JWT_SECRET=substitua-por-um-valor-aleatorio-antes-de-iniciar
CORS_ORIGINS=http://localhost:3001
